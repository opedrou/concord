#!/usr/bin/env bash
#
# concord-audio — compartilha o som de UM app numa call do Concord, no Linux.
#
# Chrome no Linux só compartilha áudio de ABA; janela e tela cheia não têm som.
# O truque antigo (escolher "Monitor of ..." como microfone) manda a call
# inteira de volta pra call, porque o monitor carrega a voz dos outros saindo
# do fone. Aqui o navegador nunca é linkado, então o isolamento é por
# construção.
#
# A cadeia:
#
#   app --(link porta a porta, ADICIONAL)--> null sink --remap--> ConcordMic
#
# O link é adicional: o app continua tocando no fone, em paralelo.
#
# POR QUE NÃO pw-loopback (o desenho original do AUDIO-APP-LINUX.md):
# medido em 2026-09-06, `pw-loopback --capture-props='target.object=<serial do
# stream>'` NÃO se prende ao stream do app. Um stream de captura só aceita
# source ou monitor de sink como alvo; com o alvo inválido o WirePlumber
# reconecta no source PADRÃO — o microfone. Resultado: a voz do dono vazava
# pra dentro do compartilhamento, em silêncio. `stream.capture.sink=true`
# também não resolve: aí ele pega o monitor do sink padrão, ou seja, o mix do
# sistema inteiro, que é exatamente o eco que queremos evitar.
#
# O link porta a porta não tem esse modo de falha: ou o link existe, ou o
# comando falha na cara. É o que o obs-pipewire-audio-capture faz.
#
# O null sink nasce com o MESMO número de canais do app, pra não descartar
# canal nenhum no caminho; quem desce pra estéreo é o module-remap-source, que
# remixa. O module-remap-source também é obrigatório por outro motivo: o
# Chromium filtra os "Monitor of ..." do enumerateDevices(), então sem ele o
# dispositivo nem aparece na app.
#
# Uso:
#   concord-audio                 menu com os apps que estão tocando
#   concord-audio 190237          casa pelo PID
#   concord-audio spotify         casa pelo nome (primeiro que bater)
#   concord-audio --list          só lista
#   concord-audio --check <alvo>  monta, mede o RMS por 1 s e desmonta
#
set -euo pipefail

SINK=concord_share
SOURCE=concord_mic
POLL_SECONDS=2

die() { echo "concord-audio: $*" >&2; exit 1; }

for tool in pw-dump pw-link pactl jq; do
  command -v "$tool" >/dev/null || die "$tool não está instalado"
done

# --- inventário -------------------------------------------------------------

# Streams de saída de áudio, menos as nossas próprias peças.
# Formato: client id<TAB>node id<TAB>nome.
#
# O `select(.type == ...Node)` não é detalhe: um objeto **Client** também
# carrega `media.class` nos props, então sem ele a lista mistura cliente com
# node — e o cliente é justamente o que NÃO tem portas pra linkar.
#
# A chave de agrupamento é o `client.id`, não o PID. Medido nesta máquina: o
# node que o Spotify realmente toca não carrega `application.process.id`
# nenhum (quem tem o PID é o objeto Client); os do Firefox carregam. `client`
# é o único campo presente nos dois casos, e um app pode ter VÁRIOS nodes —
# Firefox tem 2 — que casar por node compartilharia metade do som, em
# silêncio.
streams() {
  pw-dump | jq -r '
    .[] | select(.type == "PipeWire:Interface:Node")
        | select(.info.props."media.class" == "Stream/Output/Audio")
        | select((.info.props."node.name" // "") | startswith("concord_") | not)
        | "\(.info.props."client.id" // "-")\t\(.id)\t\(.info.props."application.name" // .info.props."node.name" // "?")"
  '
}

# client id -> PID, só pra mostrar na tela e pra aceitar PID como argumento.
pid_of_client() {
  pw-dump | jq -r --argjson cid "$1" '
    .[] | select(.type == "PipeWire:Interface:Client" and .id == $cid)
        | .info.props."application.process.id" // "-"
  ' | head -1
}

apps() {
  streams | awk -F'\t' '$1 != "-" { if (!($1 in seen)) { seen[$1]; print $1 "\t" $3 } }'
}

nodes_of() {
  streams | awk -F'\t' -v cid="$1" '$1 == cid { print $2 }'
}

# Portas de saída de um node: "id do port<TAB>canal" (FL, FR, FC, MONO...).
out_ports_of() {
  pw-dump | jq -r --argjson nid "$1" '
    .[] | select(.type == "PipeWire:Interface:Port")
        | select(.info.props."node.id" == $nid and .info.props."port.direction" == "out")
        | "\(.id)\t\(.info.props."audio.channel" // "MONO")"
  '
}

# --- cadeia -----------------------------------------------------------------

# Serve de sweep de órfãos (na entrada) e de faxina (na saída). O módulo vive
# no pipewire-pulse, não neste processo: se o script morrer de vez, o sink fica
# pendurado pra sempre e vira dispositivo fantasma no pavucontrol.
# Ordem reversa: o remap-source depende do monitor do null sink.
unload_ours() {
  pactl list short modules \
    | awk -v s="$SINK" -v m="$SOURCE" '$0 ~ s || $0 ~ m { print $1 }' \
    | sort -rn \
    | while read -r id; do pactl unload-module "$id" 2>/dev/null || true; done
}

# O sink copia o número de canais do app. Um sink estéreo receberia só FL/FR de
# um app 5.1 e o canal central — ou seja, o diálogo — sumiria no caminho.
mount_chain() {
  local channels="$1"
  pactl load-module module-null-sink \
    sink_name="$SINK" channels="$channels" \
    sink_properties=device.description=ConcordShare >/dev/null
  # ponytail: o remix pra estéreo é do remap-source. Testado só com app
  # estéreo — o multicanal não reproduz aqui, porque o app segue o layout do
  # sink de saída e o fone é estéreo. Se um dia sair torto em 5.1, o degrau
  # seguinte é um pw-loopback entre o monitor do sink e um segundo sink
  # estéreo (aí o alvo É um monitor, e o audioconvert faz a conta).
  pactl load-module module-remap-source \
    master="$SINK".monitor source_name="$SOURCE" \
    channels=2 channel_map=front-left,front-right \
    source_properties=device.description=ConcordMic >/dev/null
}

# Idempotente: linka o que ainda não está linkado e ignora o "File exists" do
# que já está. Chamado no boot e a cada volta do watcher — um jogo que recria o
# áudio ao trocar de fase ganha os links de volta sozinho.
sync_links() {
  local node port_id channel linked=0
  while read -r node; do
    [[ -n $node ]] || continue
    while IFS=$'\t' read -r port_id channel; do
      [[ -n $port_id ]] || continue
      if pw-link "$port_id" "$SINK:playback_$channel" 2>/dev/null; then
        echo "  + $channel (porta $port_id)"
        linked=$((linked + 1))
      fi
    done < <(out_ports_of "$node")
  done < <(nodes_of "$1")
  return 0
}

cleanup() {
  trap - EXIT INT TERM
  echo
  echo "desmontando..."
  # Os links morrem junto com o sink; não há processo nosso pra matar.
  unload_ours
}

# --- escolha do app ---------------------------------------------------------

# Devolve sempre um client id. Aceita client id, PID ou pedaço do nome.
resolve() {
  local arg="$1" cid
  if [[ $arg =~ ^[0-9]+$ ]]; then
    # É client id?
    if apps | cut -f1 | grep -qx "$arg"; then
      echo "$arg"
      return
    fi
    # Então tenta como PID.
    while read -r cid _; do
      [[ $(pid_of_client "$cid") == "$arg" ]] && { echo "$cid"; return; }
    done < <(apps)
    return
  fi
  apps | awk -F'\t' -v want="${arg,,}" 'tolower($2) ~ want { print $1; exit }'
}

menu() {
  local list pid name n=0
  list=$(apps)
  [[ -n $list ]] || die "nenhum app tocando som agora"
  echo "apps com som:" >&2
  while IFS=$'\t' read -r pid name; do
    n=$((n + 1))
    echo "  $n) $name (pid $(pid_of_client "$pid"))" >&2
  done <<<"$list"
  local choice
  read -rp "qual? [1-$n] " choice </dev/tty
  [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= n)) || die "escolha inválida"
  sed -n "${choice}p" <<<"$list" | cut -f1
}

# Quantos canais o app está tocando. É o que define a largura do null sink.
channels_of() {
  local first
  first=$(nodes_of "$1" | head -1)
  [[ -n $first ]] || return 1
  out_ports_of "$first" | wc -l
}

start_for() {
  local client="$1" channels
  channels=$(channels_of "$client") || die "esse app não está tocando nada agora"
  [[ ${channels:-0} -gt 0 ]] || die "esse app não está tocando nada agora"
  unload_ours
  mount_chain "$channels"
  trap cleanup EXIT INT TERM
  echo "compartilhando o áudio de $(pid_of_client "$client" | sed 's/^/pid /') ($channels canais)"
  sync_links "$client"
}

# --- checagem ---------------------------------------------------------------
#
# A checagem runnable deste script: monta a cadeia, grava 1 s do ConcordMic e
# imprime o RMS. Com o app tocando tem que dar bem acima de zero; com o app
# parado e outra coisa tocando alto tem que dar perto de zero, que é o teste de
# isolamento.
#
# Medir o RMS não basta pra dizer que está certo — um RMS gordo já foi o
# microfone pegando o som da caixa. Por isso o `--check` também imprime QUEM
# está alimentando o sink: se aparecer um `alsa_input...`, é o mic, e a cadeia
# está errada.
check() {
  local client="$1"
  start_for "$client"
  sleep 1
  echo "=== quem alimenta o $SINK ==="
  pw-link -l | grep -A2 "^$SINK:playback" || echo "  (ninguém — nenhum link de pé)"
  # `|| true`: o head fecha o cano e o parec morre de SIGPIPE (141) — com
  # pipefail isso derrubaria o script antes de imprimir o resultado.
  local rms
  rms=$( (parec --format=s16le --channels=1 --rate=48000 --device="$SOURCE" 2>/dev/null \
        | head -c 96000 \
        | od -An -td2 -w2 -v \
        | awk '{ s += $1 * $1; n++ } END { if (n) printf "%.1f\n", sqrt(s / n); else print "sem amostra" }') || true)
  echo "RMS: ${rms:-falhou}"
}

# --- main -------------------------------------------------------------------

case "${1:-}" in
  --list)
    apps | while IFS=$'\t' read -r cid name; do
      printf '%s (pid %s)\n' "$name" "$(pid_of_client "$cid")"
    done
    exit 0
    ;;
  --check)
    [[ -n ${2:-} ]] || die "--check precisa de um pid ou nome"
    target=$(resolve "$2")
    [[ -n $target ]] || die "não achei app pra '$2'"
    check "$target"
    exit 0
    ;;
  -h | --help)
    sed -n '3,44p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  "")
    target=$(menu)
    ;;
  *)
    target=$(resolve "$1")
    [[ -n $target ]] || die "não achei app pra '$1'"
    ;;
esac

start_for "$target"
echo "pronto: escolha 'ConcordMic' no botão de áudio de app do Concord."
echo "Ctrl-C desmonta tudo."

# ponytail: poll de 2 s. Trocar por `pw-dump -m` se o gap na troca de fase
# incomodar — o custo é parsear um fluxo de JSON no shell.
while true; do
  sleep "$POLL_SECONDS"
  sync_links "$target"
done
