# 1. Copy this file and rename it to .env.local
# 2. Update the enviroment variables below.

# REQUIRED SETTINGS
# ################# 
# If you are using LiveKit Cloud, the API key and secret can be generated from the Cloud Dashboard.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL pointing to the LiveKit server. (example: `wss://my-livekit-project.livekit.cloud`)
LIVEKIT_URL=

# Segredo usado pra assinar (HMAC) o cookie de sessão. Gere um valor longo e
# aleatório, ex.: `openssl rand -base64 48`. OBRIGATÓRIO em produção — a app
# recusa subir sem isso (evita cair num default inseguro sem perceber).
SESSION_SECRET=

# Primeiro admin, criado automaticamente no boot SE ainda não existir nenhum
# admin no banco. Depois de criado, gerencie usuários pela própria app
# (rotas /api/users) — essas variáveis só importam nesse primeiro boot.
ADMIN_USERNAME=
ADMIN_PASSWORD=


# BANCO DE DADOS (SQLite)
# #######################
# Diretório onde o arquivo app.db é criado. Em produção (Docker/Coolify),
# aponte para um volume persistente — o container em si é efêmero. Ver
# MIGRACAO.md na raiz do repo pro passo a passo no Coolify.
# Default: ./.data (dev local) — no Dockerfile já vem como /data.
# DATA_DIR=/data
# Alternativa: apontar o arquivo .db diretamente (tem prioridade sobre DATA_DIR).
# DATABASE_PATH=/data/app.db


# OPTIONAL SETTINGS
# ################# 
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site

